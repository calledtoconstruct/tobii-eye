[Unit]
Description=Tobii Eye Tracker 5 gaze daemon
Documentation=https://github.com/Aetherall/tobiifree

[Service]
ExecStart=/usr/bin/tobiifreed --ws 127.0.0.1:7081
# The daemon waits through unplug and replug. This restarts a crash.
Restart=on-failure
RestartSec=2

[Install]
WantedBy=default.target
