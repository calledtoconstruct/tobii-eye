# Maintainer: Joseph Woolley <joe@calledtoconstruct.net>
pkgname=tobiifreed
pkgver=0+ad82906
pkgrel=1
pkgdesc='Userspace daemon for the Tobii Eye Tracker 5'
arch=('x86_64')
url='https://github.com/Aetherall/tobiifree'
license=('GPL-3.0-only')
depends=('libusb')
makedepends=('git')
install=tobiifreed.install
options=('!debug')
source=(
  "git+https://github.com/Aetherall/tobiifree.git#commit=ad82906a9c97f03be8bfcfeff9453198f6feb7a0"
  'https://ziglang.org/download/0.15.2/zig-x86_64-linux-0.15.2.tar.xz'
  '60-tobii-eyetracker.rules'
  'tobiifreed.service'
  'reconnect.patch'
)
sha256sums=(
  'SKIP'
  '02aa270f183da276e5b5920b1dac44a63f1a49e55050ebde3aecc9eb82f93239'
  '06ceddcdcf7d5be5a9a06d7723157f0f1c099c4db9ff073cdf85f29724e668a2'
  'ffc9608306867e2a86f42d61f419ae600bbe6fb2567379d268f24de66451d26c'
  'ce0a328719c5d5cddcf07ab565a0e8ba19953798427747c2b6563726cd507645'
)

prepare() {
  cd tobiifree
  patch -p1 -i "$srcdir/reconnect.patch"
}

build() {
  cd tobiifree/applications/tobiifreed
  "$srcdir/zig-x86_64-linux-0.15.2/zig" build -Doptimize=ReleaseSafe --prefix "$srcdir/out"
}

package() {
  install -Dm755 "$srcdir/out/bin/tobiifreed" "$pkgdir/usr/bin/tobiifreed"
  install -Dm644 "$srcdir/60-tobii-eyetracker.rules" \
    "$pkgdir/usr/lib/udev/rules.d/60-tobii-eyetracker.rules"
  install -Dm644 "$srcdir/tobiifreed.service" \
    "$pkgdir/usr/lib/systemd/user/tobiifreed.service"
  install -Dm644 "$srcdir/tobiifree/LICENSE" \
    "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
